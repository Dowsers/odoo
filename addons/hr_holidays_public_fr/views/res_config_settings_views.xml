<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.holidays.public.fr</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="75"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="work_organization_setting_container" position="after">
                <block title="French Public Holidays" name="fr_public_holidays_setting_container">
                    <setting id="fr_public_holidays_zone_setting" company_dependent="1" string="Official Public Holidays"
                             help="Imported every week from calendrier.api.gouv.fr into Time Off > Configuration > Public Holidays">
                        <field name="fr_public_holidays_zone" placeholder="No import"/>
                        <div class="text-muted mt-1" invisible="not fr_public_holidays_sync_date">
                            Last import: <field name="fr_public_holidays_sync_date" class="oe_inline" readonly="1"/>
                        </div>
                        <div class="text-danger mt-1" invisible="not fr_public_holidays_sync_error">
                            <field name="fr_public_holidays_sync_error" readonly="1"/>
                        </div>
                        <div class="mt-2">
                            <button name="action_import_fr_public_holidays" type="object" string="Import Now"
                                    icon="oi-arrow-right" class="btn-link" invisible="not fr_public_holidays_zone"/>
                            <button name="%(hr_holidays_public_fr.action_hr_public_holiday_fr)d" type="action"
                                    string="Official Public Holidays" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                    <setting id="fr_whit_monday_worked_setting" string="Whit Monday Is a Worked Day"
                             help="Journée de solidarité: the upcoming Whit Mondays are not imported as public holidays, and activities can be logged on them. Past days are never changed.">
                        <field name="fr_whit_monday_worked"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
