<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_public_holiday_fr_view_list" model="ir.ui.view">
        <field name="name">hr.public.holiday.fr.list</field>
        <field name="model">hr.public.holiday.fr</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="state in ('worked', 'deleted', 'withdrawn')">
                <header>
                    <button name="action_import" type="object" string="Import Now" icon="fa-download"
                            display="always" groups="hr_holidays.group_hr_holidays_manager,base.group_system"/>
                </header>
                <field name="date"/>
                <field name="name"/>
                <field name="zone" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'imported'" decoration-info="state == 'existing'"
                       decoration-warning="state in ('deleted', 'withdrawn')"/>
                <field name="leave_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="hr_public_holiday_fr_view_search" model="ir.ui.view">
        <field name="name">hr.public.holiday.fr.search</field>
        <field name="model">hr.public.holiday.fr</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <filter name="filter_date" string="Date" date="date"/>
                <separator/>
                <filter name="filter_imported" string="Imported" domain="[('state', '=', 'imported')]"/>
                <filter name="filter_not_imported" string="Not Imported" domain="[('state', '!=', 'imported')]"/>
                <group>
                    <filter name="group_year" string="Year" context="{'group_by': 'date:year'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_public_holiday_fr" model="ir.actions.act_window">
        <field name="name">Official Public Holidays</field>
        <field name="res_model">hr.public.holiday.fr</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="hr_public_holiday_fr_view_search"/>
        <field name="context">{'search_default_group_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No official public holiday imported yet</p>
            <p>The official French public holidays are imported every week from calendrier.api.gouv.fr into the public holidays of Odoo.</p>
        </field>
    </record>

    <menuitem
        id="menu_hr_public_holiday_fr"
        action="action_hr_public_holiday_fr"
        name="Official Public Holidays"
        parent="hr_holidays.menu_hr_holidays_configuration"
        groups="hr_holidays.group_hr_holidays_manager"
        sequence="3"/>
</odoo>
