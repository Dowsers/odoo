<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- "True": Whit Monday (Lundi de Pentecôte) is a worked day (journée de solidarité),
         "False": it is a public holiday. -->
    <record id="param_whit_monday_worked" model="ir.config_parameter">
        <field name="key">hr_timesheet_consistency.whit_monday_worked</field>
        <field name="value">True</field>
    </record>
</odoo>
