<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_timesheet_cir_export.ControlPanelButton">
        <button t-if="state.visible"
                type="button"
                class="btn btn-secondary o_timesheet_cir_export_button text-nowrap"
                t-att-disabled="state.busy"
                t-on-click.stop="onClick"
                title="Download a ZIP with one CIR timesheet workbook per employee for the current year, stopped at the previous complete month">
            <i t-attf-class="fa fa-fw {{ state.busy ? 'fa-circle-o-notch fa-spin' : 'fa-download' }} me-1"/>CIR Export (ZIP)
        </button>
    </t>

    <t t-name="web.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_main_buttons')]/t[@t-slot='control-panel-always-buttons']" position="after">
            <TimesheetCirExportButton/>
        </xpath>
    </t>

</templates>
