<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_timesheet_cir_export_wizard_form" model="ir.ui.view">
        <field name="name">hr.timesheet.cir.export.wizard.form</field>
        <field name="model">hr.timesheet.cir.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    One workbook per employee (synthesis, one sheet per month), from January 1st to the end of the selected month.
                    Times are converted from hours to days with the employee's working schedule.
                </p>
                <group>
                    <group>
                        <field name="year"/>
                        <field name="month"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags"
                               context="{'active_test': False}"
                               options="{'no_create': True}"
                               placeholder="All employees with timesheets"/>
                        <field name="absence_task_ids" widget="many2many_tags"
                               context="{'active_test': False}"
                               options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Download ZIP" class="btn-primary" data-hotkey="q" icon="fa-download"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_timesheet_cir_export_wizard" model="ir.actions.act_window">
        <field name="name">CIR Export (ZIP)</field>
        <field name="res_model">hr.timesheet.cir.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
