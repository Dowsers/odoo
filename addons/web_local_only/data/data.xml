<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Telemetry sent to Odoo S.A. (services.odoo.com/publisher-warranty): deactivated.
         The method itself is neutralised in models/publisher_warranty.py. -->
    <record id="mail.ir_cron_module_update_notification" model="ir.cron">
        <field name="active" eval="False"/>
    </record>

    <!-- Apps menu: no entries to apps.odoo.com, no Enterprise modules to buy. -->
    <record id="base.menu_third_party" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="base.menu_theme_store" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="base.open_module_tree" model="ir.actions.act_window">
        <field name="domain">[('to_buy', '=', False)]</field>
    </record>
</odoo>
