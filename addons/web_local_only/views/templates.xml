<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Login page: "Powered by Odoo" link -->
    <template id="login_layout" inherit_id="web.login_layout" name="Login layout: no link to odoo.com">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace"/>
    </template>

    <!-- "Powered by" message used by the frontend footers: logo without link -->
    <template id="brand_promotion_message" inherit_id="web.brand_promotion_message" name="Brand promotion: no link to odoo.com">
        <xpath expr="//t[@t-set='odoo_logo']/a" position="replace">
            <img alt="Odoo" src="/web/static/img/odoo_logo_tiny.png" width="62" height="20"
                 style="width: auto; height: 1em; vertical-align: baseline;"/>
        </xpath>
    </template>

    <!-- Portal footer -->
    <template id="portal_record_sidebar" inherit_id="portal.portal_record_sidebar" name="Portal record sidebar: no link to odoo.com">
        <xpath expr="//a[contains(@href, 'odoo.com?utm_source=db')]" position="replace">
            <img src="/web/static/img/logo.png" alt="Odoo Logo" height="15"/>
        </xpath>
    </template>

    <!-- E-mail notification layouts: "Powered by Odoo" without link -->
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout" name="Notification layout: no link to odoo.com">
        <xpath expr="//a[contains(@href, 'odoo.com?utm_source=db')]" position="replace">
            <span>Odoo</span>
        </xpath>
    </template>
    <template id="mail_notification_light" inherit_id="mail.mail_notification_light" name="Light notification layout: no link to odoo.com">
        <xpath expr="//a[contains(@href, 'odoo.com?utm_source=db')]" position="replace">
            <span>Odoo</span>
        </xpath>
    </template>

    <!-- Periodic digest e-mail: links and "Odoo Mobile" banner -->
    <template id="digest_mail_main" inherit_id="digest.digest_mail_main" name="Digest: no link to odoo.com">
        <xpath expr="//a[@href='https://www.odoo.com']" position="replace">
            <span class="odoo_link_text">Odoo</span>
        </xpath>
        <xpath expr="//a[@href='https://www.odoo.com']" position="replace">
            <span class="odoo_link_text">Odoo</span>
        </xpath>
        <xpath expr="//tr[@t-if='display_mobile_banner']" position="replace"/>
    </template>

    <!-- Expense e-mail (the "submitted expenses" template of this database has no link) -->
    <template id="hr_expense_template_register_no_user" inherit_id="hr_expense.hr_expense_template_register_no_user" name="Expense registered: no link to odoo.com">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <span>Odoo</span>
        </xpath>
    </template>

    <!-- Settings: In-App Purchases block -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.local.only</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="iap.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='iap_purchases_setting_container']" position="replace"/>
        </field>
    </record>
</odoo>
