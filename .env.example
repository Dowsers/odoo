# Copier ce fichier vers .env (jamais commité) et remplacer les valeurs.

# Mot de passe du compte PostgreSQL « odoo » créé au premier démarrage du conteneur db.
POSTGRES_PASSWORD=changer-ce-mot-de-passe

# Mot de passe maître d'Odoo (gestionnaire de bases : sauvegarde, restauration, suppression).
ODOO_ADMIN_PASSWD=changer-ce-mot-de-passe-maitre

# Adresse HTTPS d'Odoo, celle que Tailscale publie pour la machine (voir docker/tailscale_https.sh).
HTTPS_URL=https://odoo.example.ts.net

# Valeurs par défaut, à décommenter pour les changer.
# DB_NAME=database
# ODOO_PORT=8069
# REDIRECT_PORT=8068
